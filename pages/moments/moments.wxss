/* pages/moments/moments.wxss */
.moments-page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部人设 */
.moments-header {
  position: relative;
}

.header-cover {
  height: 280rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE, #81ECEC);
  position: relative;
  overflow: hidden;
}

.header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.3));
}

.header-info {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
  display: flex;
  align-items: center;
  z-index: 1;
}

.header-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  backdrop-filter: blur(10px);
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.header-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  max-width: 500rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 控制栏 */
.control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.control-left {
  display: flex;
  align-items: center;
}

.control-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.count-picker {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: rgba(108, 92, 231, 0.08);
  border-radius: 12rpx;
}

.refresh-btn {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  background: rgba(108, 92, 231, 0.08);
  border-radius: 20rpx;
}

/* 空态 */
.generate-section {
  padding: 120rpx 32rpx;
}

.empty-card {
  text-align: center;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  box-shadow: var(--shadow);
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.8;
}

.generate-btn {
  display: inline-block;
}

/* 加载 */
.loading-section {
  padding: 120rpx 32rpx;
}

.loading-card {
  text-align: center;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  box-shadow: var(--shadow);
}

.loading-anim {
  margin-bottom: 24rpx;
}

.loading-emoji {
  font-size: 80rpx;
  display: inline-block;
  animation: pulse 1.5s ease-in-out infinite;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

/* 朋友圈列表 */
.moments-list {
  padding: 16rpx 0;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
}

.list-title {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.regenerate-btn {
  font-size: 26rpx;
  color: var(--primary);
}

/* 朋友圈卡片 */
.moment-card {
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.moment-card.copied {
  background: rgba(85, 239, 196, 0.1);
  border: 2rpx solid rgba(85, 239, 196, 0.3);
}

.moment-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.moment-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.moment-type-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(108, 92, 231, 0.08);
  color: var(--primary);
}

.moment-type-tag.news_share {
  background: rgba(0, 206, 201, 0.08);
  color: var(--accent);
}

.moment-type-tag.personal {
  background: rgba(108, 92, 231, 0.08);
  color: var(--primary);
}

.moment-type-tag.daily {
  background: rgba(85, 239, 196, 0.1);
  color: #00B894;
}

.moment-type-tag.interaction {
  background: rgba(253, 203, 110, 0.15);
  color: #E17055;
}

.moment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.moment-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  display: block;
  margin-bottom: 16rpx;
}

.news-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.news-tag {
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(0, 206, 201, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.news-source {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-left: 8rpx;
}

/* 操作栏 */
.moment-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.04);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.action-text {
  font-size: 22rpx;
}
