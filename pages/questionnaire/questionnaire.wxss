/* pages/questionnaire/questionnaire.wxss */
.questionnaire-page {
  min-height: 100vh;
  background: #F8F9FE;
  display: flex;
  flex-direction: column;
}

/* 进度条 */
.progress-bar-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(108, 92, 231, 0.1);
  z-index: 100;
  display: flex;
  align-items: center;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A29BFE);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.progress-text {
  position: absolute;
  right: 20rpx;
  top: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
}

/* 对话滚动区 */
.chat-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
  padding-top: 40rpx;
}

/* 欢迎卡片 */
.welcome-card {
  text-align: center;
  padding: 40rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, rgba(108, 92, 231, 0.08), rgba(0, 206, 201, 0.08));
  border-radius: var(--radius);
}

.welcome-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.welcome-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 消息行 */
.message-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.ai-row {
  justify-content: flex-start;
}

.user-row {
  justify-content: flex-end;
}

/* 头像 */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  background: rgba(108, 92, 231, 0.1);
}

.user-row .msg-avatar {
  background: rgba(0, 206, 201, 0.1);
}

/* 消息气泡 */
.msg-bubble {
  max-width: 70%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  line-height: 1.8;
}

.ai-bubble {
  background: #FFFFFF;
  color: var(--text-primary);
  margin-left: 16rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-bubble {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #FFFFFF;
  margin-right: 16rpx;
  border-bottom-right-radius: 8rpx;
}

.question-bubble {
  background: #FFFFFF;
  border: 2rpx solid rgba(108, 92, 231, 0.15);
}

.msg-text {
  font-size: 28rpx;
  word-break: break-all;
}

/* 打字动画 */
.typing-bubble {
  padding: 20rpx 32rpx;
}

.typing-dots {
  display: flex;
  gap: 12rpx;
}

.typing-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary-light);
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* 提示标签 */
.hints-area {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.hints-scroll {
  white-space: nowrap;
}

.hints-container {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.hint-tag {
  display: inline-flex;
  padding: 16rpx 28rpx;
  background: rgba(108, 92, 231, 0.08);
  color: var(--primary);
  border-radius: 32rpx;
  font-size: 26rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.hint-tag:active {
  background: rgba(108, 92, 231, 0.2);
  transform: scale(0.96);
}

/* 输入区域 */
.input-area {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}

.input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.msg-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.input-placeholder {
  color: var(--text-hint);
}

.send-btn {
  padding: 16rpx 32rpx;
  background: var(--text-hint);
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
}

/* 完成区 */
.completion-section {
  padding: 40rpx 0;
}

.completion-card {
  text-align: center;
  background: linear-gradient(135deg, #FFFFFF, #F0ECFF);
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  box-shadow: var(--shadow-lg);
}

.completion-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.completion-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.completion-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 32rpx;
}
