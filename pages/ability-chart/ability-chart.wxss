/* pages/ability-chart/ability-chart.wxss */
.chart-page {
  min-height: 100vh;
  background: #F8F9FE;
  padding-bottom: 40rpx;
}

/* 人设头卡 */
.persona-header {
  position: relative;
  padding-top: 80rpx;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0 40rpx;
}

.persona-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.avatar-emoji {
  font-size: 56rpx;
}

.persona-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.persona-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 20rpx;
}

.persona-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.persona-tags .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

/* 综合评分 */
.score-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 32rpx;
  margin: -20rpx 32rpx 24rpx;
  box-shadow: var(--shadow);
  position: relative;
  z-index: 2;
}

.score-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.score-number {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.score-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.score-info {
  flex: 1;
}

.score-level {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.score-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 雷达图 */
.radar-section {
  margin: 0 32rpx 24rpx;
}

.radar-container {
  width: 100%;
  display: flex;
  justify-content: center;
}

.radar-svg {
  width: 600rpx;
  height: 600rpx;
}

/* 维度列表 */
.dimensions-list {
  margin: 0 32rpx 24rpx;
}

.dimension-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.dimension-item:last-child {
  border-bottom: none;
}

.dim-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dim-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.dim-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.dim-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}

.dim-bar-container {
  padding-left: 44rpx;
}

.dim-bar-bg {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.dim-bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.8s ease;
}

/* 核心优势 */
.strengths-section {
  margin: 0 32rpx 24rpx;
}

.strengths-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.strength-item {
  display: flex;
  align-items: center;
  background: rgba(108, 92, 231, 0.05);
  padding: 20rpx;
  border-radius: 16rpx;
}

.strength-rank {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary);
  margin-right: 16rpx;
  width: 80rpx;
}

.strength-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.strength-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.strength-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.strength-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

/* 提升建议 */
.suggestions-section {
  margin: 0 32rpx 24rpx;
}

.suggestion-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.suggestion-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.suggestion-dim {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.suggestion-current {
  font-size: 24rpx;
  color: var(--warning);
}

.suggestion-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  padding-left: 36rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
}

.action-buttons .btn-secondary,
.action-buttons .btn-primary {
  flex: 1;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-popup {
  width: 80%;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  text-align: center;
  position: relative;
}

.detail-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: var(--text-hint);
  padding: 8rpx;
}

.detail-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.detail-score {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
  display: block;
  margin-bottom: 12rpx;
}

.detail-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.detail-bar-bg {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.detail-bar {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #A29BFE);
  border-radius: 8rpx;
}
