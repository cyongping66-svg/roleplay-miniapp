/* pages/adjust/adjust.wxss */
.adjust-page {
  min-height: 100vh;
  background: #F8F9FE;
  padding: 24rpx 32rpx;
  padding-bottom: 180rpx;
}

.section {
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #F5F5F5;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-textarea {
  background: #F5F5F5;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
}

/* 滑块项 */
.slider-item {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.slider-item:last-child {
  border-bottom: none;
}

.slider-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.slider-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.slider-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.slider-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  min-width: 60rpx;
  text-align: right;
}

.custom-slider {
  margin: 8rpx 0;
}

.slider-desc {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 内容配比 */
.mix-item {
  margin-bottom: 24rpx;
}

.mix-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.mix-header text:first-child {
  font-size: 28rpx;
  color: var(--text-primary);
}

.mix-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 选择器 */
.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F5F5;
  padding: 24rpx;
  border-radius: 16rpx;
}

.picker-item text:first-child {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bottom-actions .btn-secondary,
.bottom-actions .btn-primary {
  flex: 1;
}

.bottom-actions .disabled {
  opacity: 0.5;
  pointer-events: none;
}
