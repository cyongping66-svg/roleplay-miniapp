/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #F8F9FE 0%, #E8E0FF 50%, #D4F1F4 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰圆 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: var(--primary);
  top: -100rpx;
  right: -100rpx;
  animation: float 6s ease-in-out infinite;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: var(--accent);
  bottom: 200rpx;
  left: -80rpx;
  animation: float 8s ease-in-out infinite reverse;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: var(--warning);
  top: 40%;
  right: -40rpx;
  animation: float 5s ease-in-out infinite;
}

/* 浮动emoji */
.floating-emojis {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.floating-emoji {
  position: absolute;
  font-size: 36rpx;
  opacity: 0.3;
  animation: float 4s ease-in-out infinite;
}

/* 主内容 */
.main-content {
  position: relative;
  z-index: 1;
  padding: 100rpx 40rpx 40rpx;
}

/* 虚拟形象 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(108, 92, 231, 0.3) 0%, transparent 70%);
  animation: pulse 2s ease-in-out infinite;
}

.avatar {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.3);
  transition: all 0.3s ease;
  z-index: 2;
}

.avatar.excited {
  transform: scale(1.05);
}

.avatar-ring {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(108, 92, 231, 0.3);
  z-index: 1;
}

.avatar-face {
  font-size: 80rpx;
}

.avatar-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 20rpx;
}

.avatar-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 对话气泡 */
.chat-area {
  margin: 32rpx 0;
}

.bubble-container {
  position: relative;
  max-width: 90%;
  margin: 0 auto;
}

.bubble {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.1);
  position: relative;
}

.bubble-arrow {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid #FFFFFF;
}

.bubble-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
}

.typing-cursor {
  color: var(--primary);
  animation: blink 1s step-end infinite;
  font-weight: 300;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 引导操作区 */
.guide-section {
  margin-top: 40rpx;
}

.action-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  transition: all 0.3s ease;
}

.action-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-lg);
}

.primary-action {
  background: linear-gradient(135deg, #FFFFFF 0%, #F0ECFF 100%);
  border: 2rpx solid rgba(108, 92, 231, 0.2);
}

.action-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(108, 92, 231, 0.1);
  border-radius: 20rpx;
}

.action-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-arrow {
  font-size: 40rpx;
  color: var(--primary-light);
  font-weight: 300;
}

/* 功能标签 */
.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 40rpx;
  justify-content: center;
}

.feature-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  backdrop-filter: blur(10px);
}

.tag-icon {
  font-size: 28rpx;
}
