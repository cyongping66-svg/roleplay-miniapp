/* pages/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
  background: #F8F9FE;
}

/* 顶部卡片 */
.profile-header {
  position: relative;
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  padding: 80rpx 32rpx 40rpx;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

.header-bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.1) 0%, transparent 50%),
              radial-gradient(circle at 80% 20%, rgba(255,255,255,0.08) 0%, transparent 50%);
}

.profile-card {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  backdrop-filter: blur(10px);
}

.avatar-emoji {
  font-size: 56rpx;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 6rpx;
}

.profile-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  line-height: 1.6;
}

/* 统计数据 */
.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  margin-bottom: 4rpx;
}

.stat-value.top-dim {
  font-size: 24rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 标签 */
.persona-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.persona-tags .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

/* 菜单区域 */
.menu-section {
  padding: 24rpx 32rpx 0;
}

.menu-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-list {
  background: #FFFFFF;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(108, 92, 231, 0.04);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 2rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-hint);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* 危险操作 */
.danger-section {
  padding: 40rpx 32rpx;
}

.clear-btn {
  background: transparent;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 40rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.clear-btn:active {
  background: rgba(255, 118, 117, 0.08);
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-bottom: 4rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: var(--text-hint);
}
