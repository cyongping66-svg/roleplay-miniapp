<!-- pages/profile/profile.wxml -->
<view class="profile-page">
  <!-- 顶部卡片 -->
  <view class="profile-header">
    <view class="header-bg-pattern"></view>
    <view class="profile-card">
      <view class="profile-avatar">
        <text class="avatar-emoji">{{hasPersona ? '🎭' : '👤'}}</text>
      </view>
      <view class="profile-info">
        <text class="profile-name">{{hasPersona ? persona.name : '未创建人设'}}</text>
        <text class="profile-desc">{{hasPersona ? persona.description : '开始打造你的专属社交人设吧'}}</text>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="stats-row" wx:if="{{hasPersona}}">
      <view class="stat-item">
        <text class="stat-value">{{personaStats.dimensions}}</text>
        <text class="stat-label">能力维度</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{personaStats.avgScore}}</text>
        <text class="stat-label">平均分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value top-dim">{{personaStats.topDimension}}</text>
        <text class="stat-label">最强维度</text>
      </view>
    </view>

    <!-- 人设标签 -->
    <view class="persona-tags" wx:if="{{hasPersona}}">
      <text wx:for="{{persona.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <text class="menu-section-title">人设管理</text>
    <view class="menu-list">
      <view
        wx:for="{{menuItems}}"
        wx:key="id"
        class="menu-item"
        data-id="{{item.id}}"
        data-url="{{item.url}}"
        bindtap="onMenuTap"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <view class="menu-content">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="menu-section">
    <text class="menu-section-title">关于</text>
    <view class="menu-list">
      <view
        wx:for="{{aboutItems}}"
        wx:key="id"
        class="menu-item"
        data-id="{{item.id}}"
        bindtap="onAboutTap"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <view class="menu-content">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="danger-section" wx:if="{{hasPersona}}">
    <button class="clear-btn" bindtap="onClearData">清除所有人设数据</button>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">人设工坊 v1.0.0</text>
    <text class="footer-sub">Powered by AI ✨</text>
  </view>

  <!-- 底部留白 -->
  <view style="height: 120rpx;"></view>
</view>
